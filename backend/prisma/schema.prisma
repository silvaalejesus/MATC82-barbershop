generator client {
  provider   = "prisma-client"
  output     = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums mapeados para o banco de dados
enum UserRole {
  client
  admin
  barber

  @@map("user_role")
}

enum AppointmentStatus {
  confirmed
  completed
  cancelled

  @@map("appointment_status")
}

enum BarberStatus {
  active
  inactive

  @@map("barber_status")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         UserRole @default(client)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("users")
}

// Removemos o model Admin pois o SQL usa a tabela users para todos

model Barber {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  phone       String?
  role        String       @default("Barbeiro")
  specialties String[]
  status      BarberStatus @default(active)
  hireDate    DateTime?    @map("hire_date")
  imageUrl    String?      @map("image_url") // Adicionado conforme init.sql
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") // Adicionado default para evitar erro

  schedules    BarberSchedule[]
  appointments Appointment[]

  @@map("barbers")
}

model Service {
  id              String  @id @default(uuid())
  name            String
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int     @map("duration_minutes")
  description     String?
  imageUrl        String? @map("image_url")
  active          Boolean @default(true)

  appointments Appointment[]

  @@map("services")
}

model BarberSchedule {
  id          String    @id @default(uuid())
  barberId    String    @map("barber_id")
  dayOfWeek   Int       @map("day_of_week")
  isAvailable Boolean   @default(true) @map("is_available")
  startTime   DateTime  @map("start_time") @db.Time
  endTime     DateTime  @map("end_time") @db.Time
  breakStart  DateTime? @map("break_start") @db.Time
  breakEnd    DateTime? @map("break_end") @db.Time

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("barber_schedules")
}

model Appointment {
  id            String            @id @default(uuid())
  serviceId     String            @map("service_id")
  barberId      String            @map("barber_id")
  userId        String?           @map("user_id") // Pode ser nulo no SQL
  customerName  String?           @map("customer_name")
  customerPhone String?           @map("customer_phone")
  date          DateTime          @db.Date
  time          DateTime          @db.Time
  status        AppointmentStatus @default(confirmed)
  price         Decimal           @db.Decimal(10, 2)
  createdAt     DateTime          @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([date], map: "idx_appointments_date")
  @@index([barberId], map: "idx_appointments_barber")
  @@index([userId], map: "idx_appointments_user")
  @@map("appointments")
}
